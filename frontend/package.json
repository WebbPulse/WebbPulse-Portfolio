{
  "name": "webbpulse-portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:local": "vite --mode development",
    "dev:prod": "vite --mode production",
    "dev:remote-api": "VITE_API_BASE_URL=https://api.webbpulse.com/api/v1 vite --mode development",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/dompurify": "^3.2.0",
    "@types/marked": "^5.0.2",
    "@webbpulse/api-client": "^0.9.0",
    "@webbpulse/auth": "^0.9.0",
    "@webbpulse/config": "^0.9.0",
    "@webbpulse/discovery": "^0.9.0",
    "@webbpulse/qrcode": "^0.9.0",
    "dompurify": "^3.4.15",
    "marked": "^16.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@webbpulse/eslint-config": "^0.9.0",
    "@webbpulse/tsconfig": "^0.9.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
