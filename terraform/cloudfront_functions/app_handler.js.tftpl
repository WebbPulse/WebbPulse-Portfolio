/**
 * Rebuilds the request query string for a redirect, preserving multi-value parameters.
 * @param {object} request CloudFront Functions viewer-request request.
 * @returns {string} The query string with a leading ?, or an empty string.
 */
function legacyHostQueryString(request) {
  var parts = [];
  var qs = request.querystring || {};
  for (var k in qs) {
    var entry = qs[k];
    var ek = encodeURIComponent(k);
    if (entry.multiValue) {
      for (var i = 0; i < entry.multiValue.length; i++) {
        parts.push(ek + "=" + encodeURIComponent(entry.multiValue[i].value));
      }
    } else {
      parts.push(ek + "=" + encodeURIComponent(entry.value));
    }
  }
  return parts.length ? "?" + parts.join("&") : "";
}

/**
 * CloudFront viewer-request handler for the frontend distribution.
 * Answers a request for a legacy host with a 301 to the same path and query
 * string on ${canonical_host}, and passes every other request through.
 * @param {object} event CloudFront Functions viewer-request event.
 * @returns {object} A 301 response for a legacy host, otherwise the unchanged request.
 */
function appHandler(event) {
  var request = event.request;
  var legacyHosts = ${jsonencode(legacy_hosts)};
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : "";
  if (legacyHosts.indexOf(host) !== -1) {
    return {
      statusCode: 301,
      statusDescription: "Moved Permanently",
      headers: {
        location: {
          value: "https://${canonical_host}" + request.uri + legacyHostQueryString(request),
        },
      },
    };
  }
  return request;
}
